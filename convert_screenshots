#!/usr/bin/env bash
#
# convert_screenshots - bash port of the python version.
# Deps: curl, jq, sha256sum/coreutils, imagemagick (magick), xargs (GNU findutils)

set -uo pipefail

SITE_DIR="${1:-${SITE_DIR:-}}"
if [ -z "$SITE_DIR" ]; then
    echo "Usage: convert_screenshots <site_dir> [repo_dir]" >&2
    exit 1
fi
REPO_DIR="${2:-${REPO_DIR:-.}}"
QUALITY="${WEBP_QUALITY:-100}"

APPS_DIR="$REPO_DIR/apps"
CACHE_DIR="$REPO_DIR/.cache/screenshots"
DL_DIR="$CACHE_DIR/downloads"
WEBP_DIR="$CACHE_DIR/webp"
MANIFEST="$CACHE_DIR/manifest.json"
OUT_DIR="$SITE_DIR/screenshots"
RESULTS_DIR=""

MAX_BYTES=$((64 * 1024 * 1024))
USER_AGENT="Mozilla/5.0 (convert_screenshots; +https://portable-linux-apps.github.io)"
MAX_WORKERS=8

for bin in jq curl sha256sum; do
    command -v "$bin" >/dev/null 2>&1 || { echo "Error: $bin not found" >&2; exit 1; }
done

MAGICK=""
for cmd in magick magick-im7.q16; do
    if p=$(command -v "$cmd" 2>/dev/null); then
        MAGICK="$p"
        break
    fi
done
if [ -z "$MAGICK" ]; then
    echo "Error: magick not found (install it with: sudo pacman -S imagemagick)" >&2
    exit 1
fi

cleanup() {
    [ -n "$RESULTS_DIR" ] && rm -rf "$RESULTS_DIR"
}
trap cleanup EXIT

stable_key() {
    printf '%s' "$1" | sha256sum | cut -c1-16
}

ext_for() {
    local url="$1" path_only ext
    path_only="${url%%\?*}"
    path_only="${path_only%%#*}"
    ext=$(printf '%s' "$path_only" | grep -oE '\.[A-Za-z0-9]+$' | tr '[:upper:]' '[:lower:]')
    case "$ext" in
        .png) echo "png" ;;
        .jpg) echo "jpg" ;;
        .jpeg) echo "jpeg" ;;
        .gif) echo "gif" ;;
        .bmp) echo "bmp" ;;
        *) echo "img" ;;
    esac
}

collect_urls() {
    local fname path token path_only
    [ -d "$APPS_DIR" ] || return 0
    for path in "$APPS_DIR"/*; do
        [ -f "$path" ] || continue
        fname=$(basename "$path")
        case "$fname" in
            .*|*~) continue ;;
        esac
        while IFS= read -r line; do
            [[ "$line" =~ ^#[[:space:]]*SCREENSHOTS[[:space:]]*:[[:space:]]*(.+[^[:space:]])[[:space:]]*$ ]] || continue
            for token in ${BASH_REMATCH[1]}; do
                case "$token" in
                    http://*|https://*) ;;
                    *) continue ;;
                esac
                path_only="${token%%\?*}"
                path_only="${path_only%%#*}"
                shopt -s nocasematch
                [[ "$path_only" == *.webp ]] && { shopt -u nocasematch; continue; }
                shopt -u nocasematch
                printf '%s\n' "$token"
            done
        done < "$path"
    done
}

# fetch URL, optionally with an ETag. Writes body to $3 and headers to $4.
# echoes one of: ok unchanged missing error
fetch() {
    local url="$1" etag="$2" body_file="$3" headers_file="$4" code
    local -a curl_args=(-sS -L --max-time 60 --max-filesize "$MAX_BYTES"
                         -A "$USER_AGENT" -D "$headers_file" -o "$body_file"
                         -w '%{http_code}')
    if [ -n "$etag" ]; then
        curl_args+=(-H "If-None-Match: $etag")
    fi
    if ! code=$(curl "${curl_args[@]}" "$url" 2>/dev/null); then
        echo "error"
        return
    fi
    case "$code" in
        304) echo "unchanged" ;;
        404) echo "missing" ;;
        200) echo "ok" ;;
        *) echo "error" ;;
    esac
}

header_value() {
    # header_value <headers_file> <name>
    grep -i "^$2:" "$1" 2>/dev/null | tail -1 | sed -E "s/^[^:]+:[[:space:]]*//; s/[\r\n]+$//"
}

is_image_body() {
    local f="$1" magic
    magic=$(head -c 12 "$f" | od -An -tx1 | tr -d ' \n')
    case "$magic" in
        89504e470d0a1a0a*) return 0 ;;  # PNG
        ffd8ff*) return 0 ;;            # JPEG
        4749463837a1*|4749463839a1*) return 0 ;; # GIF87a/89a (ascii 'a' = 0x61, fix below)
    esac
    # GIF/WEBP checks via ascii (simpler, avoids od encoding mistakes above)
    local head6 head4 head8_12
    head6=$(head -c 6 "$f")
    [ "$head6" = "GIF87a" ] && return 0
    [ "$head6" = "GIF89a" ] && return 0
    head4=$(head -c 4 "$f")
    if [ "$head4" = "RIFF" ]; then
        head8_12=$(dd if="$f" bs=1 skip=8 count=4 2>/dev/null)
        [ "$head8_12" = "WEBP" ] && return 0
    fi
    return 1
}

convert_to_webp() {
    local src="$1" dst="$2" tmp="${2}.tmp"
    mkdir -p "$(dirname "$dst")"
    if timeout 120 "$MAGICK" -quality "$QUALITY" "$src" "$tmp" >/dev/null 2>&1; then
        mv "$tmp" "$dst"
        return 0
    fi
    rm -f "$tmp"
    return 1
}

# Runs in a worker subprocess. Reads manifest entry for the url (if any) via
# jq lookup on the shared manifest file (read-only during the parallel phase).
# Writes its outcome as JSON to $RESULTS_DIR/<key>.result and bumps a stat
# counter by touching $RESULTS_DIR/stats/<stat>.<key>.
process_url() {
    local url="$1"
    local key entry has_webp body_file headers_file status etag sha dl_file webp_file
    key=$(stable_key "$url")
    dl_file="$DL_DIR/${key}.$(ext_for "$url")"
    webp_file="$WEBP_DIR/${key}.webp"
    entry=$(jq -c --arg u "$url" '.[$u] // empty' "$MANIFEST_SNAPSHOT")
    has_webp=0
    [ -f "$webp_file" ] && has_webp=1

    body_file=$(mktemp)
    headers_file=$(mktemp)

    if [ -n "$entry" ] && [ "$has_webp" = 1 ]; then
        etag=$(printf '%s' "$entry" | jq -r '.etag // empty')
        if [ -n "$etag" ]; then
            status=$(fetch "$url" "$etag" "$body_file" "$headers_file")
            case "$status" in
                unchanged)
                    touch "$RESULTS_DIR/stats/unchanged.$key"
                    printf '%s' "$entry" > "$RESULTS_DIR/$key.result"
                    rm -f "$body_file" "$headers_file"
                    return 0
                    ;;
                missing)
                    touch "$RESULTS_DIR/stats/missing.$key"
                    rm -f "$body_file" "$headers_file"
                    return 0
                    ;;
                ok) ;; # fall through to (re)write below
                *)
                    touch "$RESULTS_DIR/stats/changed.$key"
                    rm -f "$body_file" "$headers_file"
                    return 0
                    ;;
            esac
        else
            touch "$RESULTS_DIR/stats/unchanged.$key"
            printf '%s' "$entry" > "$RESULTS_DIR/$key.result"
            rm -f "$body_file" "$headers_file"
            return 0
        fi
    else
        status=$(fetch "$url" "" "$body_file" "$headers_file")
        case "$status" in
            missing)
                touch "$RESULTS_DIR/stats/missing.$key"
                rm -f "$body_file" "$headers_file"
                return 0
                ;;
            ok) ;;
            *)
                touch "$RESULTS_DIR/stats/failed.$key"
                rm -f "$body_file" "$headers_file"
                return 0
                ;;
        esac
        touch "$RESULTS_DIR/stats/downloaded.$key"
        if ! is_image_body "$body_file"; then
            touch "$RESULTS_DIR/stats/failed.$key"
            rm -f "$body_file" "$headers_file"
            return 0
        fi
    fi

    sha=$(sha256sum "$body_file" | cut -d' ' -f1)
    mkdir -p "$DL_DIR"
    mv "$body_file" "$dl_file"

    head4=$(head -c 4 "$dl_file")
    is_webp=0
    if [ "$head4" = "RIFF" ]; then
        w=$(dd if="$dl_file" bs=1 skip=8 count=4 2>/dev/null)
        [ "$w" = "WEBP" ] && is_webp=1
    fi

    if [ "$is_webp" = 1 ]; then
        mkdir -p "$WEBP_DIR"
        cp "$dl_file" "$webp_file"
    else
        if ! convert_to_webp "$dl_file" "$webp_file"; then
            touch "$RESULTS_DIR/stats/failed.$key"
            rm -f "$headers_file"
            return 0
        fi
        touch "$RESULTS_DIR/stats/converted.$key"
    fi

    etag=$(header_value "$headers_file" "ETag")
    rm -f "$headers_file"
    jq -n -c --arg file "$(basename "$dl_file")" --arg webp "${key}.webp" \
        --arg sha "$sha" --arg etag "$etag" \
        '{file:$file, webp:$webp, sha256:$sha, etag:(if $etag=="" then null else $etag end)}' \
        > "$RESULTS_DIR/$key.result"
    echo "$key" > "$RESULTS_DIR/$key.ok"
}
export -f process_url fetch header_value is_image_body convert_to_webp stable_key ext_for
export MAGICK QUALITY MAX_BYTES USER_AGENT DL_DIR WEBP_DIR RESULTS_DIR MANIFEST_SNAPSHOT

replace_in_file() {
    # replace_in_file <path> <rel_prefix> <mapping_file: url<TAB>key>
    local path="$1" rel_prefix="$2" mapping_file="$3" count=0 url key n
    [ -s "$mapping_file" ] || return 0
    content=$(cat "$path" 2>/dev/null) || return 0
    changed=0
    while IFS=$'\t' read -r url key; do
        [ -z "$url" ] && continue
        n=$(grep -o -F "$url" <<<"$content" | wc -l)
        if [ "$n" -gt 0 ]; then
            content="${content//$url/${rel_prefix}screenshots/${key}.webp}"
            count=$((count + n))
            changed=1
        fi
    done < "$mapping_file"
    if [ "$changed" = 1 ]; then
        printf '%s' "$content" > "$path.tmp"
        mv "$path.tmp" "$path"
    fi
    echo "$count"
}

main() {
    local urls_file url_count
    urls_file=$(mktemp)
    collect_urls | sort -u > "$urls_file"
    url_count=$(wc -l < "$urls_file")
    if [ "$url_count" -eq 0 ]; then
        echo "no screenshot URLs found in app files"
        rm -f "$urls_file"
        return
    fi

    mkdir -p "$CACHE_DIR"
    [ -f "$MANIFEST" ] || echo '{}' > "$MANIFEST"
    MANIFEST_SNAPSHOT=$(mktemp)
    jq -c '.' "$MANIFEST" > "$MANIFEST_SNAPSHOT" 2>/dev/null || echo '{}' > "$MANIFEST_SNAPSHOT"
    export MANIFEST_SNAPSHOT

    RESULTS_DIR=$(mktemp -d)
    mkdir -p "$RESULTS_DIR/stats"
    export RESULTS_DIR

    xargs -a "$urls_file" -d '\n' -P "$MAX_WORKERS" -I{} bash -c 'process_url "$@"' _ {}

    # Build key->result and url->key mapping, tally stats
    local mapping_file results_json
    mapping_file=$(mktemp)
    results_json=$(mktemp)
    echo '{}' > "$results_json"
    while IFS= read -r url; do
        key=$(stable_key "$url")
        if [ -f "$RESULTS_DIR/$key.result" ]; then
            printf '%s\t%s\n' "$url" "$key" >> "$mapping_file"
            jq -c --arg u "$url" --arg k "$key" --slurpfile r "$RESULTS_DIR/$key.result" \
                '. + {($u): $r[0]}' "$results_json" > "$results_json.tmp" && mv "$results_json.tmp" "$results_json"
            if [ -f "$RESULTS_DIR/$key.ok" ]; then
                printf '%s\n' "$key" >> "$RESULTS_DIR/ok_keys"
            fi
        fi
    done < "$urls_file"

    local downloaded converted unchanged missing failed changed
    downloaded=$(find "$RESULTS_DIR/stats" -name 'downloaded.*' 2>/dev/null | wc -l)
    converted=$(find "$RESULTS_DIR/stats" -name 'converted.*' 2>/dev/null | wc -l)
    unchanged=$(find "$RESULTS_DIR/stats" -name 'unchanged.*' 2>/dev/null | wc -l)
    missing=$(find "$RESULTS_DIR/stats" -name 'missing.*' 2>/dev/null | wc -l)
    failed=$(find "$RESULTS_DIR/stats" -name 'failed.*' 2>/dev/null | wc -l)
    changed=$(find "$RESULTS_DIR/stats" -name 'changed.*' 2>/dev/null | wc -l)

    # new manifest = results_json entries for urls we saw, dropped otherwise
    jq -s '.[0] * .[1] | with_entries(select(.value != null))' \
        <(echo '{}') "$results_json" > "$MANIFEST.tmp"
    # keep only urls that are still referenced (matches python's prune step)
    jq --slurpfile keep <(jq -R . "$urls_file" | jq -s .) \
        'with_entries(select(.key as $k | $keep[0] | index($k)))' \
        "$MANIFEST.tmp" > "$MANIFEST.tmp2"
    mv "$MANIFEST.tmp2" "$MANIFEST"
    rm -f "$MANIFEST.tmp" "$results_json"

    rm -rf "$OUT_DIR"
    mkdir -p "$OUT_DIR" "$WEBP_DIR"
    local copied=0
    if [ -d "$WEBP_DIR" ]; then
        for webp in "$WEBP_DIR"/*.webp; do
            [ -f "$webp" ] || continue
            cp -p "$webp" "$OUT_DIR/"
            copied=$((copied + 1))
        done
    fi

    local replaced_total=0 n
    while IFS= read -r -d '' f; do
        rel="${f#"$SITE_DIR"/}"
        case "$rel" in
            .cache/*|*/.cache/*) continue ;;
        esac
        depth=$(tr -dc '/' <<<"$rel" | wc -c)
        rel_prefix=$(printf '../%.0s' $(seq 1 "$depth" 2>/dev/null))
        n=$(replace_in_file "$f" "$rel_prefix" "$mapping_file")
        replaced_total=$((replaced_total + n))
    done < <(find "$SITE_DIR" \( -name '*.json' -o -name '*.html' \) -print0)

    echo "screenshots: $downloaded downloaded, $converted converted, " \
         "$unchanged unchanged (cache), $missing not found, " \
         "$failed failed, $copied webp in $OUT_DIR, " \
         "$replaced_total URL references replaced" | tr -s ' '

    rm -f "$urls_file" "$mapping_file" "$MANIFEST_SNAPSHOT"
}

main "$@"
